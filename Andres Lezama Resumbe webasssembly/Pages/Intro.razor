@page "/Intro"


 <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">

<!-- Slideshow container -->
<div class="slideshow-container">

    <!-- Full-width images with number and caption text -->
    <div class="mySlides">
        <div class="numbertext">1 / 5</div>
        <img src="/Pictures/img1.jpg" class="w3-animate-opacity" style="width:100%">
        <div class="text">Graduation</div>
    </div>

    <div class="mySlides">
        <div class="numbertext">2 / 5</div>
        <img src="/Pictures/img2.jpg" class="w3-animate-opacity" style="width:100%">
        <div class="text">Russia, Red Square</div>
    </div>

    <div class="mySlides">
        <div class="numbertext">3 / 5</div>
        <img src="/Pictures/img3.jpg" class="w3-animate-opacity" style="width:100%">
        <div class="text">Some of my family!</div>
    </div>

    <div class="mySlides">
        <div class="numbertext">4 / 5</div>
        <img src="/Pictures/img4.jpg" class="w3-animate-opacity" style="width:100%">
        <div class="text">Paris, Eiffel Tower</div>
    </div>

    <div class="mySlides">
        <div class="numbertext">5 / 5</div>
        <img src="/Pictures/img5.jpg" class="w3-animate-opacity" style="width:100%">
        <div class="text">Belize, swimming with sharks!</div>
    </div>

    <!-- Next and previous buttons -->
    <a class="prev" onclick="plusSlides(-1)">&#10094;</a>
    <a class="next" onclick="plusSlides(1)">&#10095;</a>
</div>
<br>

<!-- The dots/circles -->
<div style="text-align:center">
    <span class="dot" onclick="currentSlide(1)"></span>
    <span class="dot" onclick="currentSlide(2)"></span>
    <span class="dot" onclick="currentSlide(3)"></span>
    <span class="dot" onclick="currentSlide(4)"></span>
    <span class="dot" onclick="currentSlide(5)"></span>
</div>


<div class="text-container">
    <p>
        Hi! I am Andres Lezama, I am 25 years old and I welcome to my life! Born in Venezuela, now American and could not be happier here. Before the U.S. I lived and visited many
        countries like Brazil, Russia, and many others, meeting people from all around the world and learning from their cultures. I am fluent in English and Spanish,
        currently learning Portuguese as I loved Brazil (their food is the best!). Other languagues I learned included 5 years of German at "Deutsche Schule Maracaibo"
        and a year of Russian at the "Anglo-American School of Moscow". I aim to meet more people, take on new challenges, and learn more!
    </p>
</div>


<script>
    setTimeout(() => {
        let slideIndex = 1;
        showSlides(slideIndex);
        setInterval(() => plusSlides(1), 4000);

        // Next/previous controls
        window.plusSlides = function (n) {
            showSlides(slideIndex += n);
        }

        // Thumbnail image controls
        window.currentSlide = function (n) {
            showSlides(slideIndex = n);
        }

        function showSlides(n) {
            let i;
            let slides = document.getElementsByClassName("mySlides");
            let dots = document.getElementsByClassName("dot");

            if (slides.length === 0 || dots.length === 0) return; // safety

            if (n > slides.length) { slideIndex = 1 }
            if (n < 1) { slideIndex = slides.length }

            for (i = 0; i < slides.length; i++) {
                slides[i].style.display = "none";
            }
            for (i = 0; i < dots.length; i++) {
                dots[i].className = dots[i].className.replace(" active", "");
            }

            slides[slideIndex - 1].style.display = "block";
            dots[slideIndex - 1].className += " active";
        }
    }, 500); // Delay to ensure DOM is rendered
</script>